---
import ButtonSend from "../components/ButtonSend.astro";
import InputText from "../components/InputText.astro";
import RadioButtonGroup from "../components/RadioButtonGroup.astro";
import Select from "../components/Select.astro";
import FormLayout from "../layouts/FormLayout.astro";


---
<FormLayout>
	<h2 class="subtitulo" slot="subtitulo">Ingrese información</h2>
	<InputText 
	    etiqueta="Nombre completo"
	    slot="caja-texto-nombre"
		 
	  />
	<InputText
	  	etiqueta="Apellido completo"
		slot="caja-texto-apellido"
	/>
	<InputText
	  	etiqueta="Correo Electronico"
		slot="email"
	/>

	<RadioButtonGroup
		etiqueta="Seleccione tipo de documento"
		slot="grupo-radio"
	/>
	<Select
		etiqueta="Seleccione ciudad:"
		slot="select-ciudades"
	/>
	<ButtonSend
		etiqueta="enviar"
		slot="boton-envio"
	/>
</FormLayout>
<style>
    .subtitulo{
        font-weight: 300;
		font-family: Arial, Helvetica, sans-serif;
        font-size: 25px;
        color: red;
		margin-left: 20px;
		margin-top: 20px;
		
    }
</style>