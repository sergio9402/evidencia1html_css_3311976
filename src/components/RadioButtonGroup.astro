---
//div:etiqueta abierta
// tiene elementos dentro
// permite establecer propiedades de ubicacion
// definimos las propiedades
// que puede recibir componentes
    interface Props {
        etiqueta:string;
        
    
}

    const etiqueta = Astro.props.etiqueta;
    
---
<label>{etiqueta}</label>
<div class="rbgl">
    
   
    <div id="cedula" >
        <input class="radio-btn" 
            type="radio"
            name="rbg"
            id="radio1"
        />
        C.C
    </div>
    <div id="tarjeta-identidad">
        <input class="radio-btn" 
        type="radio"
         name="rbg"
        id="radio2"
        />
        T.I
    </div>
    <div id="cedula-extrangera">
        <input class="radio-btn" 
        type="radio"
         name="rbg"
        id="radio3"
    /> 
    C.E
    
   
    </div>
    
</div>
<style>
    .rbgl{
        background-color: rgb(236, 236, 238);
        border-width: 1px;
        border-style: solid;
        border-radius: 5px;
        margin:40px 0 10px 20px ;
        width: 90%;
        padding-left: auto;

    }
    #cedula .radio-btn{
        background-color: rgb(87, 150, 113);
        /*display:
        determina como una etiqueta se comportara en cuanto a:display largo , ancho , ubicacion;*/
        display: inline-block;
        width: 10px;
        height: 10px;
         
        
    }
    #tarjeta-identidad .radio-btn{
        background-color: blue;
        display: inline-block;
        width: 10px;
        height: 10px;
    }     
        
    #cedula-extrangera .radio-btn{
        background-color: blueviolet;
        display: inline-block;
        width: 10px;
        height: 10px;
         
    }
    
    margin top;10px
</style>