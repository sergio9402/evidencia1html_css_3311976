---
    interface Props {
        etiqueta:string;
        
    
}

    const etiqueta = Astro.props.etiqueta;
    
---
<button class="boton-envio">
    {etiqueta}
</button>
<style>
    /*estilos de clase */
    /*solo se aplican a los elementos*/
    /*que tengan el atributo class*/
    /*el mismo nombre de class*/
    .boton-envio{
        background-color: rgb(15, 216, 42);
        color: aliceblue;
        width: 100px;
        height: 40px;
        border-top-right-radius: 10px;
    }
</style>