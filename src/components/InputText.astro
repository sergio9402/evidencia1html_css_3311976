---
// definimos las propiedades
// que puede recibir componentes
    interface Props {
        etiqueta:string;
        
    
}
//crear una variable
//para recibir la etiqueta
//valores enviados desde el control
    const etiqueta = Astro.props.etiqueta;
    
---

<!--
etiqueta input:
se utiliza para los siguientes controles:
- campo de texto
- password
- chekbox
- radio button
- boton de envio
ES ETIQUETA  CERRADA
 -->
<label>{etiqueta}</label>
<input type="text" />
<style>
    /*solo se puede poner aqui sintaxis css*/
    /*estilos para input text*/
    /*selector de etiqueta:*/
    /*estilos aplicables a toda etiqueta*/
    /*señala el selector*/
    input[type="text"]{
        background-color: chartreuse;
        width: 400px;
        height: 20px;
        color: blue;
        /*border debe tener color peso o grosor estilo y tipo de linea*/
        border-color: rgb(226, 74, 81);
        border-width: 1px;
        border-style: solid;
        border-radius: 5px;
    }

</style>
    